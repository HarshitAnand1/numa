# apps/demo-shop (Vite). Copy to .env.local. Nothing here is secret: Vite exposes VITE_* to the browser.

# Where `vite dev` forwards /api/* (numa's API; its demo /orders route signs the order)
VITE_API_PROXY=http://localhost:8787

# This shop's campaign on-chain (a merchant creates it; its payout signer must be the key the order endpoint signs with)
VITE_CAMPAIGN_ID=7

# Leave unset until the contracts are deployed: the shop then says checkout isn't available.
# If unset, @numa/shared's recorded DEPLOYED_ADDRESSES is used.
# VITE_NUMA_ROUTER_ADDRESS=0x...
# VITE_CAMPAIGN_REGISTRY_ADDRESS=0x...
# VITE_RPC_URL=https://rpc.testnet.whitechain.io

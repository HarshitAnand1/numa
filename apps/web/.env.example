# apps/web (Vite). Copy to .env.local. Nothing here is secret: Vite exposes VITE_* to the browser.

# Where `vite dev` forwards /api/* (the apps/api server, default port 8787)
VITE_API_PROXY=http://localhost:8787

# Production only: absolute URL of a deployed API (it must send CORS headers, which apps/api does not yet)
# VITE_API_URL=https://api.example.com

# Force clearly-labelled demo data and never call the API
# VITE_DATA_MODE=demo

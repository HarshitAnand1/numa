# Whitechain Sepolia
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
# Whitechain Sepolia deployment (public; checked on-chain 2026-11-07). Both were created in block 12414186.
CAMPAIGN_REGISTRY_ADDRESS=0xD924385D22626dB2894D25b5f12253BC36148425
NUMA_ROUTER_ADDRESS=0x51fCf8F50ABB17a0d4D70BA14B4F6394A583c2Fc
# Where the indexer and the CSV export start scanning (the deployment block)
INDEXER_START_BLOCK=12414186

# Deployer wallet for packages/contracts/script/Deploy.s.sol — a Foundry encrypted keystore
# account (created with `cast wallet import <name> --interactive`), NOT a raw private key.
# Never put a private key in this file. See docs/SMART_CONTRACTS.md -> Deployment.
DEPLOYER_KEYSTORE_ACCOUNT=
# Protocol fee recipient address for NumaRouter's constructor (FEE_RECIPIENT below is what the
# deploy script actually reads; this just documents which wallet it should be).
FEE_RECIPIENT=
FEE_BPS=50
REFUND_WINDOW_SECONDS=86400
# Deploy script refuses to broadcast to any chain other than this one (see Deploy.s.sol).
# 1874 = Whitechain Sepolia testnet, 1875 = Whitechain Mainnet.
EXPECTED_CHAIN_ID=1874
# Relayer (hot key, funded with WBT; never commit a real value)
RELAYER_PRIVATE_KEY=
RELAYER_MAX_GAS_PRICE_GWEI=
RELAYER_DAILY_CAP_WBT=
# Merchant order signer (demo shop)
MERCHANT_SIGNER_KEY=
# Numa conversion writer wallet for Arkiv
ARKIV_WRITER_PRIVATE_KEY=
# Arkiv testnet Rabdi (chain 7794095); free key from hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
INDEXER_START_BLOCK=0
INDEXER_POLL_MS=5000
# Backend
DATABASE_URL=postgres://numa:numa@localhost:5432/numa

# Arkiv dev wallets for the live round-trip check (testnet only; generate locally, never commit)
ARKIV_TEST_MERCHANT_KEY=
ARKIV_TEST_CREATOR_KEY=

# Click tracker
CHECKOUT_BASE_URL=http://localhost:3000
CLICK_RATE_LIMIT_PER_MINUTE=3000
CLICK_VISITOR_SECRET=
KEEPER_POLL_MS=30000

# Browser origins allowed to call the API (comma-separated, or *). Empty disables CORS headers.
CORS_ORIGINS=
DISCOVERY_TIMEOUT_MS=15000

# Negotiation agents (optional). The agent wallet only writes Arkiv entities; fund it with tGLM. Users bind its address with a numa.agent entity.
AGENT_WALLET_PRIVATE_KEY=
AGENT_POLL_MS=15000
# Optional: Claude phrases agent notes (decisions never depend on it).
ANTHROPIC_API_KEY=
AGENT_LLM_MODEL=claude-opus-5-5
